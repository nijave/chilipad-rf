/* Larger CDC ACM TX FIFO: one 255 byte capture prints as a ~1.1 kB line, and
 * uart_poll_out() discards bytes when this FIFO is full (flow control off). */
&board_cdc_acm_uart {
	tx-fifo-size = <8192>;
};

/* Second command port for the ESP32 bridge: uart0 on TX P0.20 / RX P0.24,
 * 115200 8N1, no flow control.  The board's uart0_default also routes RTS
 * (P0.17) and CTS (P0.22); these groups leave both pads unassigned. */
&pinctrl {
	uart0_cmd_default: uart0_cmd_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 20)>;
		};

		group2 {
			psels = <NRF_PSEL(UART_RX, 0, 24)>;
			/* Idle-high when nothing drives RX (ESP32 not connected). */
			bias-pull-up;
		};
	};

	uart0_cmd_sleep: uart0_cmd_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 20)>,
				<NRF_PSEL(UART_RX, 0, 24)>;
			low-power-enable;
		};
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	/delete-property/ hw-flow-control;
	pinctrl-0 = <&uart0_cmd_default>;
	pinctrl-1 = <&uart0_cmd_sleep>;
	pinctrl-names = "default", "sleep";
};
