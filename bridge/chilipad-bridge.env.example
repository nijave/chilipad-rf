# Copy to ~/.config/chilipad-bridge.env on the Pine and `chmod 600` it.
# Podman reads this file with --env-file: one KEY=value per line, no quotes,
# no `export`, no variable expansion. Quote characters become part of the value.

CHILIPAD_MQTT_HOST=broker.lan
CHILIPAD_MQTT_PORT=1883
CHILIPAD_MQTT_USER=chilipad
CHILIPAD_MQTT_PASSWORD=change-me

# Optional:
#CHILIPAD_NAME=ChiliPad Cube
#CHILIPAD_UNIQUE_ID=chilipad_cube
#CHILIPAD_LOG_LEVEL=INFO
# CHILIPAD_PORT is set in the quadlet (/dev/chilipad); do not set it here.
