# ChiliPad Cube MQTT bridge (chilipad_bridge.py) as an OCI image.
#
# Build both architectures with ./build.sh. Single-arch local build:
#   podman build -t chilipad-bridge:dev -f Containerfile .
#
# Only chilipad_bridge.py and the locked dependencies (uv.lock) go into the
# image; uv itself stays in the builder stage. The --selftest mode reads
# captures/ and analysis/ from the repo, so run it from a checkout, not here.
#
# Serial access: the image runs as the non-root user "chilipad" (UID 10001).
# It does not run as root to open the dongle. Rootless Podman passes the host
# device node through with its host owner (root:dialout, mode 0660). Run with
# --group-add keep-groups (quadlet GroupAdd=keep-groups) so the process keeps
# the host user's supplementary groups, including dialout. See README.md.

FROM ghcr.io/astral-sh/uv:0.13.7 AS uv

# Builder: resolve exactly what uv.lock pins into /app/.venv.
FROM docker.io/library/python:3.15.2-slim-trixie AS build
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/.venv
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project

# Runtime: the same base image, so the venv's python symlink resolves.
FROM docker.io/library/python:3.15.2-slim-trixie

ARG VERSION=dev

LABEL org.opencontainers.image.title="chilipad-bridge" \
      org.opencontainers.image.description="Home Assistant MQTT bridge for the ChiliPad Cube through the chilipad-sniffer nRF52840 dongle" \
      org.opencontainers.image.source="https://github.com/nijave/chilipad-rf" \
      org.opencontainers.image.version="${VERSION}"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/app/.venv/bin:$PATH

RUN useradd --uid 10001 --user-group --no-create-home \
        --home-dir /nonexistent --shell /usr/sbin/nologin chilipad

# WORKDIR first, so /app exists as 0755 before the copies. BuildKit's
# COPY --chmod would also apply its mode to a parent directory it creates,
# which left /app without the execute bit.
WORKDIR /app
COPY --from=build /app/.venv /app/.venv
COPY chilipad_bridge.py /app/chilipad_bridge.py

USER 10001:10001

ENTRYPOINT ["/app/.venv/bin/python", "/app/chilipad_bridge.py"]
